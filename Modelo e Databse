CREATE DATABASE ModeloProfessor;
USE ModeloProfessor;

-- ==========================
-- Criação das tabelas Dimensão
-- ==========================

CREATE TABLE DimProfessor (
    idProfessor INT PRIMARY KEY,
    nome VARCHAR(100),
    titulacao VARCHAR(50),
    especialidade VARCHAR(100),
    tempoCasa INT,
    regimeTrabalho VARCHAR(50)
);

CREATE TABLE DimCurso (
    idCurso INT PRIMARY KEY,
    nomeCurso VARCHAR(100),
    nivel VARCHAR(50),
    modalidade VARCHAR(50),
    areaConhecimento VARCHAR(100)
);

CREATE TABLE DimDisciplina (
    idDisciplina INT PRIMARY KEY,
    nomeDisciplina VARCHAR(100),
    codigo VARCHAR(20),
    cargaHoraria INT,
    tipo VARCHAR(50)
);

CREATE TABLE DimDepartamento (
    idDepartamento INT PRIMARY KEY,
    nomeDepartamento VARCHAR(100),
    areaAcademica VARCHAR(100),
    localizacao VARCHAR(100)
);

CREATE TABLE DimData (
    idData INT PRIMARY KEY,
    dataOferta DATE,
    ano INT,
    semestre INT,
    mes INT,
    diaSemana VARCHAR(20)
);

-- ==========================
-- Criação da tabela Fato
-- ==========================

CREATE TABLE FatoProfessor (
    idFato INT PRIMARY KEY AUTO_INCREMENT,
    idProfessor INT,
    idCurso INT,
    idDisciplina INT,
    idDepartamento INT,
    idData INT,
    cargaHorariaMinistrada DECIMAL(5,2),
    qtdDisciplinasOfertadas INT,
    qtdCursosMinistrados INT,
    numeroTurmasAssociadas INT,
    FOREIGN KEY (idProfessor) REFERENCES DimProfessor(idProfessor),
    FOREIGN KEY (idCurso) REFERENCES DimCurso(idCurso),
    FOREIGN KEY (idDisciplina) REFERENCES DimDisciplina(idDisciplina),
    FOREIGN KEY (idDepartamento) REFERENCES DimDepartamento(idDepartamento),
    FOREIGN KEY (idData) REFERENCES DimData(idData)
);

